  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "1-build-kg": "npm run 1-fetch && npm run 1-reconstruct && npm run 1-validate && npm run 1-graph",
    "1-fetch": "node src/1-build-kg/1-fetch-dataset.js",
    "1-reconstruct": "node src/1-build-kg/2-reconstruct-source.js",
    "1-validate": "node src/1-build-kg/3-validate-roundtrip.js",
    "1-graph": "node src/1-build-kg/4-build-graph.js",
    "2-enrich": "node src/2-enrich-kg/1-enrich.js",
    "3-landkarte": "node src/3-use-cases/landkarte-roundtrip/1-build-sources.js",
    "3-landkarte:validate": "node src/3-use-cases/landkarte-roundtrip/2-validate-roundtrip.js",
    "3-landkarte:serve": "node src/3-use-cases/landkarte-roundtrip/3-serve-landkarte.js",
    "3-landkarte:page": "node src/3-use-cases/landkarte-roundtrip/4-build-page.js",
    "webapp": "node src/common/serve-webapp.js",
    "webapp:stage": "node src/common/stage-webapp.js",
    "prewebapp": "npm run webapp:stage"
  },
  "dependencies": {
    "@foerderfunke/sem-ops-utils": "^0.5.1",
    "js-yaml": "^4.1.0"
