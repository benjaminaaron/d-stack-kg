PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX ds:     <https://deutschland-stack.gov.de/id/>
PREFIX dstack: <https://deutschland-stack.gov.de/vocab#>

# The category/subcategory nesting becomes a SKOS taxonomy: each Schicht
# (category) is a top concept, each Gruppe (subcategory) a narrower concept
# under it. Concept IRIs are slugs of the names (prefixed schicht-/gruppe- so
# the two levels never collide).
CONSTRUCT {
    ds:landkarte a skos:ConceptScheme ;
        skos:prefLabel "Tech-Stack Landkarte of the Deutschland-Stack"@en ;
        skos:hasTopConcept ?schicht .
    ?schicht a skos:Concept ;
        skos:prefLabel ?schichtLabel ;
        skos:topConceptOf ds:landkarte ;
        skos:inScheme ds:landkarte ;
        dstack:landkartePosition ?cPos .
    ?gruppe a skos:Concept ;
        skos:prefLabel ?gruppeLabel ;
        skos:broader ?schicht ;
        skos:inScheme ds:landkarte ;
        dstack:landkartePosition ?sPos .
} WHERE {
    [] xyz:categories ?cats .
    # facade-x models a YAML list as an rdf container (rdf:_1, rdf:_2, …);
    # matching any rdf:_N predicate iterates its members
    ?cats ?cSlot ?cat .
    FILTER(STRSTARTS(STR(?cSlot), STR(rdf:_)))
    ?cat xyz:name ?schichtName ; xyz:subcategories ?subs .
    ?subs ?sSlot ?sub .
    FILTER(STRSTARTS(STR(?sSlot), STR(rdf:_)))
    ?sub xyz:name ?gruppeName .

    # the rdf:_N container index is the source order; keep it as
    # dstack:landkartePosition (category order, and subcategory order within the
    # category) so the graph can reproduce the original layout, not an arbitrary one
    BIND(xsd:integer(STRAFTER(STR(?cSlot), STR(rdf:_))) AS ?cPos)
    BIND(xsd:integer(STRAFTER(STR(?sSlot), STR(rdf:_))) AS ?sPos)

    BIND(STRLANG(?schichtName, "de") AS ?schichtLabel)
    BIND(STRLANG(?gruppeName, "de") AS ?gruppeLabel)

    # slugify Schicht name
    BIND(REPLACE(REPLACE(REPLACE(REPLACE(LCASE(?schichtName), "ä","a"),"ö","o"),"ü","u"),"ß","ss") AS ?c0)
    BIND(REPLACE(REPLACE(?c0, "[^a-z0-9]+","-"), "^-+|-+$","") AS ?cslug)
    BIND(IRI(CONCAT(STR(ds:), "schicht-", ?cslug)) AS ?schicht)

    # slugify Gruppe name
    BIND(REPLACE(REPLACE(REPLACE(REPLACE(LCASE(?gruppeName), "ä","a"),"ö","o"),"ü","u"),"ß","ss") AS ?g0)
    BIND(REPLACE(REPLACE(?g0, "[^a-z0-9]+","-"), "^-+|-+$","") AS ?gslug)
    BIND(IRI(CONCAT(STR(ds:), "gruppe-", ?gslug)) AS ?gruppe)
}
