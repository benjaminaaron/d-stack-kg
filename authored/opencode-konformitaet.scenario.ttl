    dstack:paket "rusqlite" ; dstack:ausManifest "onlineformular-backend/Cargo.toml" .

oc:d-fim-uuid a dstack:Abhaengigkeit ;
    rdfs:label "uuid"@de ;
    dstack:paket "uuid" ; dstack:ausManifest "onlineformular-backend/Cargo.toml" .

oc:d-fim-vite a dstack:Abhaengigkeit ;
    rdfs:label "vite"@de ;
    dstack:paket "vite" ; dstack:ausManifest "package.json" .

oc:d-fim-bootstrap a dstack:Abhaengigkeit ;
    rdfs:label "bootstrap"@de ;
    dstack:paket "bootstrap" ; dstack:ausManifest "package.json" .

# -----------------------------------------------------------------------------
# Recognised proprietary products (dstack:ProprietaeresProdukt): closed products
# a scanner positively knows. Where the D-Stack offers an open equivalent it is named
# concisely via dstack:offeneAlternative (plus a fuller dct:description); a captcha service
# has none. Distinct from "nicht erkannt" (a dependency with no mapping at all),
# so the two are never conflated.
# -----------------------------------------------------------------------------
oc:prod-recaptcha a dstack:ProprietaeresProdukt ;
    rdfs:label "Google reCAPTCHA Enterprise"@de ;
    dct:description "Proprietärer Captcha-Dienst (Google Cloud, USA), kein offener Standard im D-Stack. Souveränitätsrisiko."@de .

oc:prod-oracle a dstack:ProprietaeresProdukt ;
    rdfs:label "Oracle Database"@de ;
    dstack:offeneAlternative "PostgreSQL"@de ;
    dct:description "Proprietäre Datenbank neben PostgreSQL; im D-Stack stünde mit PostgreSQL eine offene Alternative."@de .

oc:prod-axonivy a dstack:ProprietaeresProdukt ;
    rdfs:label "Axon Ivy (BPM)"@de ;
    dstack:offeneAlternative "Workflowautomatisierung (Low-Code)"@de ;
    dct:description "Proprietäre BPM-/Workflow-Engine; im D-Stack-Standardbereich Workflowautomatisierung (Low-Code) gäbe es offene Alternativen."@de .

# -----------------------------------------------------------------------------
# Referenced standards without a Landkarte tile (blinde Flecken). Same
# dstack:ReferenzierterStandard + dstack:inLandkarte machinery as the kommunale
# IT landscape and the Beschlusslage layer: real, governed standards a repo uses
# that the Tech-Stack-Landkarte does not (yet) list. A finding, not a claim that
# they belong there.
# -----------------------------------------------------------------------------
oc:std-xrechnung a dstack:ReferenzierterStandard ;
    rdfs:label "XRechnung (XÖV-Standard für elektronische Rechnungen)"@de ;
    dstack:inLandkarte false ;
    dct:source <https://www.xrepository.de/details/urn:xoev-de:kosit:standard:xrechnung> .

oc:std-xbau a dstack:ReferenzierterStandard ;
    rdfs:label "XBau (XÖV-Standard im Bauwesen)"@de ;
    dstack:inLandkarte false ;
    dct:source <https://www.xrepository.de/details/urn:xoev-de:fim:standard:xbau> .

# Temporal is a workflow-orchestration technology SPARK builds on. The Landkarte's
# Workflowautomatisierung area lists other tools but not Temporal, so it surfaces here as
# an off-Landkarte finding (an Anregung to extend the map), not as a defect.
oc:std-temporal a dstack:ReferenzierterStandard ;
    rdfs:label "Temporal (Workflow-Orchestrierung, ohne Landkarte-Kachel)"@de ;
    dstack:inLandkarte false ;
    dct:source <https://temporal.io/> .

# -----------------------------------------------------------------------------
# How this fits openCode's existing, LIVE badge system (BSI/ZenDiS, opencode.de).
# openCode already badges repositories in five dimensions. Each is modelled as a
# dstack:OpenCodeBadge and crosswalked (skos:closeMatch / relatedMatch) to the
# D-Stack's own six Konformität-Kriterien, so where the two systems overlap and
# where the D-Stack adds something becomes queryable. The sixth badge is a clearly
# marked PROPOSAL of this prototype (dstack:vorgeschlagen true), NOT an official
# openCode badge: it scores the architecture-sovereignty axes openCode does not
# (Souveränität, Interoperabilität, Zukunftsfähigkeit), from the same dependency/SBOM data.
# -----------------------------------------------------------------------------
oc:badge-maintenance a dstack:OpenCodeBadge ;
    rdfs:label "Aktive Wartung"@de ;
    dct:description "Commit-Frequenz, Reaktionszeit auf Issues, mehrere aktive Maintainer."@de ;
    schema:url <https://opencode.de/de/wissen/softwareverzeichnis/badges> ;
    skos:closeMatch ds:kriterium-nachhaltigkeit .

oc:badge-reuse a dstack:OpenCodeBadge ;
    rdfs:label "Aktive Nachnutzung"@de ;
    dct:description "CI-Erfolg und tatsächlicher Einsatz in (mehreren) Organisationen."@de ;
    schema:url <https://opencode.de/de/wissen/softwareverzeichnis/badges> ;
    skos:closeMatch ds:kriterium-marktrelevanz .

oc:badge-licensing a dstack:OpenCodeBadge ;
    rdfs:label "Open-Source-Lizenz"@de ;
    dct:description "Eine von ZenDiS anerkannte Open-Source-Lizenz."@de ;
    schema:url <https://opencode.de/de/wissen/softwareverzeichnis/badges> ;
    skos:relatedMatch ds:kriterium-digitale-souveraenitaet .

oc:badge-security a dstack:OpenCodeBadge ;
    rdfs:label "Sicherheit"@de ;
    dct:description "Geschützte Branches, Code-Review, Behebung bekannter Schwachstellen (CVE) — Level 3: kritische Lücken binnen eines Tages."@de ;
    schema:url <https://opencode.de/de/wissen/softwareverzeichnis/badges> ;
    skos:closeMatch ds:kriterium-vertrauenswuerdigkeit .

oc:badge-supplychain a dstack:OpenCodeBadge ;
    rdfs:label "Lieferketten-Transparenz"@de ;
    dct:description "SLSA-Konformität, SBOM, VEX und Build-/Source-Provenance der Lieferkette."@de ;
    schema:url <https://opencode.de/de/wissen/softwareverzeichnis/badges> .

# the proposed sixth dimension — a prototype proposal, not an official openCode badge
oc:badge-dstack a dstack:OpenCodeBadge ;
    rdfs:label "Deutschland-Stack-Konformität"@de ;
    dstack:vorgeschlagen true ;
    dct:description "Vorschlag dieses Prototyps (nicht offiziell von openCode): bewertet aus denselben Manifest-/SBOM-Daten, ob ein Projekt auf die verbindlichen, souveränen D-Stack-Standards setzt — die Architektur-Achsen, die die fünf bestehenden Badges nicht abdecken."@de .
