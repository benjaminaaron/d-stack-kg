# =============================================================================
# Deutschland-Stack KG term definitions
# -----------------------------------------------------------------------------
# Makes explicit the dstack: terms that the generated graph
# (data/1-build-kg/landscape.ttl → data/2-enrich-kg/d-stack-kg.ttl) uses.
# This is a plain RDFS description, not an OWL ontology: it documents what
# the terms mean, it does not impose formal semantics or reasoning.
#
# Companion prose: modeling-notes.md (the judgment calls behind these terms).
#
# The graph's shape, in brief: a SKOS taxonomy (ds:landkarte ConceptScheme →
# Schichten → Gruppen) classifies a set of dstack:StackElement items; each item
# is scored against six dstack:Kriterium via reified dstack:Konformitaetsbewertung
# nodes. A handful of "landkarte*" predicates carry projection/layout facts.
#
# An administrative layer sits on top of this technical one: real public services
# (cpsv:PublicService, ingested from the FITKO PVOG Suchdienst) with their competent
# authorities, online-service channels and life events — modelled with the EU
# public-service vocabularies (CPSV-AP and the CCCEV / Core Public Service "m8g"
# cluster) directly, not re-invented here. It is bridged to the technical layer by
# the predicate dstack:realisiertDurch — a hand-curated proposal for which real
# Landkarte StackElements an Onlinedienst is built on.
#
# A governance layer sits above both: the IT-Planungsrat's binding Standardbereiche
# and the five Basisdienste (each realised by an exchangeable Produkt, again via
# dstack:realisiertDurch), every fact dct:source'd to a dated dstack:Beschluss;
# dstack:nenntStandard links a Standardbereich to the Landkarte tiles it makes binding.
#
# Further authored and scenario layers reuse this core and mint only a few terms of
# their own (all defined below): communication snippets (dstack:Textbaustein) and an
# openCode D-Stack-conformance scan (dstack:Abhaengigkeit, dstack:abgebildetAuf); a
# fictional municipal IT-landscape reuses ArchiMate by IRI. graph.js lists every layer
# with its provenance class.
# =============================================================================

@prefix dstack: <https://deutschland-stack.gov.de/vocab#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix voaf:   <http://purl.org/vocommons/voaf#> .
# the EU public-service vocabularies the administrative layer reuses directly, the
# FIM-identifier namespace (ours; unofficial), and GerPS (for the LeiKa-ID alignment)
@prefix cpsv:   <http://purl.org/vocab/cpsv#> .                 # Core Public Service Vocabulary
@prefix m8g:    <http://data.europa.eu/m8g/> .                  # CPSV-AP / CCCEV cluster (CPSV-AP binds this as cv:)
@prefix fim:    <https://deutschland-stack.gov.de/fim#> .       # local, unofficial RDF rendering of FIM keys
@prefix gerps:   <https://w3id.org/gerps/ontology/process/> .   # GerPS-Process (openDVA / Uni Jena)
@prefix gerpsdf: <https://w3id.org/gerps/ontology/datafield/> . # GerPS-Datafield (openDVA's RDF rendering of XDatenfelder)
@prefix fitconnect: <https://deutschland-stack.gov.de/fit-connect#> . # local, unofficial RDF rendering of FIT-Connect concepts (no official RDF / GerPS term exists)
@prefix archimate: <https://purl.org/archimate#> .              # ArchiMate ontology (Mendoza, Apache-2.0), reused by IRI for the IT-landscape layer


# --- Vocabulary description ---------------------------------------------------
<https://deutschland-stack.gov.de/vocab>
    a voaf:Vocabulary ;
    rdfs:label "Deutschland-Stack KG vocabulary"@en ;
    rdfs:comment "Terms used by the (unofficial) Deutschland-Stack knowledge graph."@en ;
    # the external vocabularies whose terms the graph reuses
    # (the details are in the comment block at the foot of this file)
    voaf:reliesOn
        <http://www.w3.org/2004/02/skos/core#> ,
        <http://purl.org/dc/terms/> ,
        <http://schema.org/> ,
        <http://purl.org/vocab/cpsv#> ,
        <http://data.europa.eu/m8g/> ,
        <https://w3id.org/gerps/ontology/process/> ,
        <https://w3id.org/gerps/ontology/datafield/> ,
        <https://purl.org/archimate#> ,
        <http://www.w3.org/ns/dcat#> ,
        <http://www.w3.org/ns/shacl#> ;
    rdfs:seeAlso <https://codeberg.org/benjaminaaron/d-stack-kg> .


# =============================================================================
# Classes
# =============================================================================

dstack:StackElement a rdfs:Class ;
    rdfs:label "Stack-Element"@de , "Stack element"@en ;
    rdfs:comment "A technology or standard tile of the Tech-Stack-Landkarte; the source badge also types it as dstack:Standard or dstack:Technologieprodukt."@en .

dstack:Standard a rdfs:Class ;
    rdfs:subClassOf dstack:StackElement ;
    rdfs:label "Standard"@de , "Standard"@en ;
    rdfs:comment "A StackElement the source badges 'Standard'."@en .

dstack:Technologieprodukt a rdfs:Class ;
    rdfs:subClassOf dstack:StackElement ;
    rdfs:label "Technologieprodukt"@de , "Technology product"@en ;
    rdfs:comment "A StackElement the source badges 'Technologie'."@en .

dstack:Kriterium a rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Bewertungskriterium"@de , "Assessment criterion"@en ;
    rdfs:comment "One of the six fixed Konformität dimensions a StackElement is scored against."@en .

dstack:Konformitaetsbewertung a rdfs:Class ;
    rdfs:label "Konformitätsbewertung"@de , "Conformity assessment"@en ;
    rdfs:comment "Reified score: one StackElement × one Kriterium → a level (stufe) and a percentage (wertProzent)."@en .

# The administrative layer adds no local classes: its instances are typed directly
# with the EU public-service classes (cpsv:PublicService, m8g:PublicOrganisation,
# m8g:LifeEvent, m8g:Channel) — see the reused-vocabularies block at the foot.

# The governance layer (authored/beschlusslage.authored.ttl) transcribes the
# IT-Planungsrat decisions: the binding Standardbereiche and the Basisdienste, each
# fact dct:source'd to a dated dstack:Beschluss. The Produkte that realise the
# Basisdienste reuse archimate:ApplicationComponent (no local class).

dstack:Beschluss a rdfs:Class ;
    rdfs:label "Beschluss"@de , "Decision"@en ;
    rdfs:comment "A dated IT-Planungsrat decision. Nodes in the governance layer cite one via dct:source, so each is traceable to its source decision (carrying its dct:date and schema:url). Provenance is node-level, not per-statement."@en .

dstack:Standardbereich a rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Standardbereich"@de , "Standard area"@en ;
    rdfs:comment "One of the binding standard areas the IT-Planungsrat defines (Anlage Standards). It names the standards it binds (dstack:nenntStandard) and carries the open Festlegungsbedarfe (dstack:festlegungsbedarf). A classification parallel to the Landkarte's own Schicht/Gruppe taxonomy, not a relabeling of it."@en .

dstack:Basisdienst a rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Basisdienst"@de , "Base service"@en ;
    rdfs:comment "One of the five Basisdienste of the Deutschland-Stack portfolio (Anlage Portfolio): a Digital-Public-Infrastructure slot realised by an exchangeable Produkt (dstack:realisiertDurch). schema:funder on the Produkt marks Bund financing (B-2026/18); its absence is itself the queryable distinction."@en .


# =============================================================================
# Properties — StackElement
# =============================================================================

dstack:badge a rdf:Property ;
    rdfs:label "Badge"@de , "badge"@en ;
    rdfs:domain dstack:StackElement ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "The source 'Standard'/'Technologie' badge; redundant with the rdf:type, kept for the renderer."@en .

dstack:reifegrad a rdf:Property ;
    rdfs:label "Reifegrad"@de , "maturity"@en ;
    rdfs:domain dstack:StackElement ;
    rdfs:comment "Maturity ('graduated', 'incubating', 'sandbox'); currently a literal."@en ;
    rdfs:seeAlso <https://github.com/cncf/toc> .

dstack:verantwortlicheStelle a rdf:Property ;
    rdfs:label "verantwortliche Stelle"@de , "responsible body"@en ;
    rdfs:domain dstack:StackElement ;
    rdfs:comment "The body responsible for the element (e.g. 'IETF', 'W3C'); currently a name literal."@en ;
    rdfs:seeAlso dct:publisher .

dstack:konformitaet a rdf:Property ;
    rdfs:label "Konformität"@de , "conformity"@en ;
    rdfs:domain dstack:StackElement ;
    rdfs:range dstack:Konformitaetsbewertung ;
    rdfs:comment "A StackElement's link to one of its Konformitätsbewertungen."@en .


# =============================================================================
# Properties — Konformitaetsbewertung
# =============================================================================

dstack:element a rdf:Property ;
    rdfs:label "Element"@de , "element"@en ;
    rdfs:domain dstack:Konformitaetsbewertung ;
    rdfs:range dstack:StackElement ;
    rdfs:comment "The StackElement a Konformitätsbewertung is about."@en .

dstack:kriterium a rdf:Property ;
    rdfs:label "Kriterium"@de , "criterion"@en ;
    rdfs:domain dstack:Konformitaetsbewertung ;
    rdfs:range dstack:Kriterium ;
    rdfs:comment "The Kriterium a Konformitätsbewertung scores against."@en .

dstack:stufe a rdf:Property ;
    rdfs:label "Stufe"@de , "level"@en ;
    rdfs:domain dstack:Konformitaetsbewertung ;
    rdfs:range xsd:integer ;
    rdfs:comment "Assessment level — the N from the source's 'N von 5'."@en .

dstack:wertProzent a rdf:Property ;
    rdfs:label "Wert (Prozent)"@de , "value (percent)"@en ;
    rdfs:domain dstack:Konformitaetsbewertung ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Assessment value normalized to 0–100 (the source mixes '10%', '33,3%', '63.0'); optional."@en .


# =============================================================================
# Property — "realised by", connecting layers
# -----------------------------------------------------------------------------
# Used in two places, hence no single rdfs:domain/range:
#   (1) the assumed bridge — an Onlinedienst (m8g:Channel) is built on a Landkarte
#       StackElement. No register records this, so its edges are a hand-curated
#       proposal (pvog-dstack-bridge.assumed.ttl), using only real StackElements.
#   (2) the governance layer — a dstack:Basisdienst is provided by its Produkt (an
#       archimate:ApplicationComponent), transcribed from the Portfolio annex and
#       dct:source'd to the Beschluss (beschlusslage.authored.ttl).
# Truth-status is carried by the file (.assumed) and by dct:source, not by the predicate.
# =============================================================================

dstack:realisiertDurch a rdf:Property ;
    rdfs:label "realisiert durch"@de , "realised by"@en ;
    rdfs:comment "X is realised by Y: an Onlinedienst (m8g:Channel) by a Landkarte StackElement (the assumed bridge), or a Basisdienst by its Produkt (the governance layer). See the section comment for the provenance of each use."@en .


# =============================================================================
# Properties — the governance layer (the Beschlusslage)
# =============================================================================

dstack:nenntStandard a rdf:Property ;
    rdfs:label "nennt Standard"@de , "names standard"@en ;
    rdfs:domain dstack:Standardbereich ;
    rdfs:comment "A Standardbereich names this standard as binding. The object is a Landkarte StackElement where the standard is a tile, or a dstack:ReferenzierterStandard (dstack:inLandkarte false) where the decision names it but the Landkarte lacks it (e.g. SPARQL/OWL/SKOS) — so the gap is queryable, not papered over. No single rdfs:range for that reason."@en .

dstack:festlegungsbedarf a rdf:Property ;
    rdfs:label "Festlegungsbedarf"@de , "open standardisation item"@en ;
    rdfs:domain dstack:Standardbereich ; rdfs:range rdfs:Literal ;
    rdfs:comment "An open standardisation item the IT-Planungsrat itself flags as not yet settled within a Standardbereich, transcribed verbatim. A literal for now; a later foresight step may promote it to a node that demonstrations attach to."@en .


# =============================================================================
# Properties — the FIM LeiKa-ID (the one administrative key with no standard term)
# -----------------------------------------------------------------------------
# Everything else in the administrative layer reuses standard EU terms directly
# (see the reused-vocabularies block at the foot). FIM is published only as XSD/XÖV,
# with no official RDF namespace, so the LeiKa-ID lives in a local, explicitly
# unofficial namespace and is aligned to the GerPS/openDVA ontology, which is the
# one published RDF rendering of this concept. The lbid uses dct:identifier and the
# ARS the official DCAT-AP.de regional-key IRI (via dct:spatial) — no local terms.
# =============================================================================

fim:leikaId a rdf:Property ;
    rdfs:label "LeiKa-ID"@de , "LeiKa ID"@en ;
    rdfs:domain cpsv:PublicService ; rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf gerps:GPP_0000030 ;   # GerPS-Process "has LeiKa-ID" (see modeling-notes.md)
    rdfs:comment "Leistungskatalog key (PVOG leikakeys[]); the FIM/PVOG join key. Local, unofficial RDF term aligned to GerPS; the authoritative scheme is the XRepository LeiKa code list."@en ;
    rdfs:seeAlso <https://w3id.org/gerps/ontology/process/GPP_0000030> ,
                 <https://www.xrepository.de/details/urn:xoev-de:fim:codeliste:leika> .

fim:leistungstyp a rdf:Property ;
    rdfs:label "Leistungstyp"@de , "service type"@en ;
    rdfs:domain cpsv:PublicService ; rdfs:range rdfs:Literal ;
    rdfs:comment "The LeiKa Leistungstyp from the FIM Steckbrief: 'lo' (Leistungsobjekt), 'lov' (mit Verrichtung) or 'lovd' (mit Verrichtung und Detaillierung). Local, unofficial FIM term."@en .


# =============================================================================
# The FIT-Connect / Fachdatenschema layer
# -----------------------------------------------------------------------------
# A third layer joins services to the data they collect: from a FIT-Connect Zustellpunkt
# (read anonymously) we learn, per Leistung (by LeiKa), the Fachdatenschema its submissions
# must conform to, a real link FIM itself does not expose. The schema is either a governed
# XÖV standard (e.g. XSozial) or a bespoke per-service JSON schema; dct:conformsTo links it,
# dct:source is its authoritative URN/URL. The Zustellpunkt lives in our (unofficial)
# fitconnect: namespace, since FIT-Connect publishes no RDF and GerPS covers the process,
# not the transmission layer. dstack:ReferenzierterStandard + dstack:inLandkarte mark the
# referenced XÖV standards absent from the Tech-Stack-Landkarte: a queryable finding, not a
# claim they belong there. The Datenfelder a schema is built from live in fim: (see below).
# =============================================================================

fitconnect:Zustellpunkt a rdfs:Class ;
    rdfs:label "Zustellpunkt"@de , "delivery point"@en ;
    rdfs:comment "A FIT-Connect delivery point where a Behörde receives applications, for the Leistungen and region it serves."@en ;
    rdfs:seeAlso <https://docs.fitko.de/fit-connect/> .

fitconnect:zustellpunkt a rdf:Property ;
    rdfs:label "Zustellpunkt"@de , "delivery point"@en ;
    rdfs:domain cpsv:PublicService ; rdfs:range fitconnect:Zustellpunkt ;
    rdfs:comment "A FIT-Connect delivery point that receives applications for this Leistung (for the region it covers). A Leistung may have several."@en .

fitconnect:status a rdf:Property ;
    rdfs:label "Status"@de , "status"@en ;
    rdfs:domain fitconnect:Zustellpunkt ; rdfs:range rdfs:Literal ;
    rdfs:comment "The FIT-Connect Zustellpunkt status (e.g. 'active'), as returned by the Submission API."@en .

fitconnect:plattform a rdf:Property ;
    rdfs:label "Plattform"@de , "platform"@en ;
    rdfs:domain fitconnect:Zustellpunkt ; rdfs:range rdfs:Literal ;
    rdfs:comment "The deploying platform or standard behind a Zustellpunkt (e.g. 'govOS/THAVEL', 'KAM (Digital-First)', 'XSozial-Basis'), derived from its Fachdatenschema URI. A human-readable identity where the FIT-Connect read gives only a destinationId UUID."@en .

dstack:Fachdatenschema a rdfs:Class ;
    rdfs:label "Fachdatenschema"@de , "subject data schema"@en ;
    rdfs:comment "The data schema a Leistung's submission must conform to, declared by a Zustellpunkt: a governed standard or a bespoke per-service schema (dct:source is its authoritative URN or URL)."@en .

dstack:ReferenzierterStandard a rdfs:Class ;
    rdfs:label "referenzierter Standard"@de , "referenced standard"@en ;
    rdfs:comment "A governed standard that real administrative data references (e.g. the XÖV standard XSozial) but that is absent from the Tech-Stack-Landkarte (dstack:inLandkarte false). A finding, not a claim that it belongs there."@en .

dstack:inLandkarte a rdf:Property ;
    rdfs:label "in der Landkarte"@de , "in the Landkarte"@en ;
    rdfs:domain dstack:ReferenzierterStandard ; rdfs:range xsd:boolean ;
    rdfs:comment "Whether this referenced standard appears as a tile in the Tech-Stack-Landkarte. false marks a coverage gap the graph surfaces."@en .

dstack:serialisiertAls a rdf:Property ;
    rdfs:label "serialisiert als"@de , "serialised as"@en ;
    rdfs:domain dstack:Fachdatenschema ; rdfs:range dstack:StackElement ;
    rdfs:comment "The Landkarte data-format tile (e.g. XML, JSON) a Fachdatenschema is serialised in: the format is a tile even where the domain standard (e.g. XSozial) is not. A format identification, not a guess."@en .

# The Datenfeld is a FIM concept (the FIM Baukasten), kept in fim: though the graph reaches it
# via the FIT-Connect Fachdatenschema. A schema's fields form a tree (Datenfeldgruppe contains
# Datenfelder / sub-groups), as the Baukasten does. We keep a lightweight local class (label +
# cited Baustein) and align it upward, like fim:leikaId: rdfs:subClassOf openDVA's GerPS-Datafield
# (its published RDF rendering), rdfs:seeAlso the XÖV standard XDatenfelder (KoSIT/XRepository)
# that GerPS-Datafield renders.
fim:Datenfeld a rdfs:Class ;
    rdfs:subClassOf gerpsdf:GPD_0000004 ;   # GerPS-Datafield "Versioned datafield"
    rdfs:label "Datenfeld"@de , "data field"@en ;
    rdfs:comment "A single (leaf) data field a submission collects, defined by its Fachdatenschema. Only bespoke per-service (JSON) schemas expose these; generic standards like XSozial-Basis do not."@en ;
    rdfs:seeAlso <https://w3id.org/gerps/ontology/datafield/GPD_0000004> ,
                 <https://www.xrepository.de/details/urn:xoev-de:fim:standard:xdatenfelder> .

fim:Datenfeldgruppe a rdfs:Class ;
    rdfs:subClassOf gerpsdf:GPD_0000005 ;   # GerPS-Datafield "Versioned datafield group"
    rdfs:label "Datenfeldgruppe"@de , "data field group"@en ;
    rdfs:comment "A group of Datenfelder (and sub-groups) within a Fachdatenschema — the FIM Datenfeldgruppe. It contains its members via fim:datenfeld."@en ;
    rdfs:seeAlso <https://w3id.org/gerps/ontology/datafield/GPD_0000005> ,
                 <https://www.xrepository.de/details/urn:xoev-de:fim:standard:xdatenfelder> .

fim:datenfeld a rdf:Property ;
    rdfs:label "Datenfeld"@de , "data field"@en ;
    rdfs:comment "Containment edge: a Fachdatenschema or Datenfeldgruppe contains this member (a fim:Datenfeld or nested fim:Datenfeldgruppe), chaining down the field tree."@en .

fim:baustein a rdf:Property ;
    rdfs:label "FIM-Baustein"@de , "FIM building block"@en ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "The FIM Baukasten id (a Datenfeld 'F…' or Datenfeldgruppe 'G…') a field/group declares itself based on, read from the schema's own text. Local, unofficial term. Where the id resolves centrally, the node also carries an rdfs:seeAlso to its FIM Portal page; its absence flags a block not centrally published (e.g. a vendor's own Nummernkreis)."@en ;
    rdfs:seeAlso <https://fimportal.de/fields/baukasten> .


# =============================================================================
# Properties — Landkarte projection facts
# -----------------------------------------------------------------------------
# These describe how the data sits in the Landkarte *projection* (its layout and
# build inputs), not domain semantics. The 'landkarte' stem keeps them distinct,
# exactly as motivated in modeling-notes.md.
# =============================================================================

dstack:landkartePosition a rdf:Property ;
    rdfs:label "Landkarte-Position"@de , "Landkarte position"@en ;
    rdfs:range xsd:integer ;
    rdfs:comment "Source order in the Landkarte (Schicht, Gruppe, item-within-Gruppe). Used on items and taxonomy concepts, hence no rdfs:domain."@en .

dstack:landkarteItemId a rdf:Property ;
    rdfs:label "Landkarte-Item-ID"@de , "Landkarte item id"@en ;
    rdfs:domain dstack:StackElement ; rdfs:range rdfs:Literal ;
    rdfs:comment "The landscape2 item id of a StackElement (its category/subcategory/name slug, e.g. '-plattform---daten--extensible-markup-language-xml'), taken verbatim from the published full.json. It is the tile's deep-link: technologie.deutschland-stack.gov.de/?item=<id>. A projection fact, not domain semantics."@en .

dstack:landkarteLogoFile a rdf:Property ;
    rdfs:label "Landkarte-Logodatei"@de , "Landkarte logo file"@en ;
    rdfs:domain dstack:StackElement ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "The logo filename used by the landscape2 build; a build-support fact, not a schema:logo URL."@en .

dstack:landkarteAnnotationKey a rdf:Property ;
    rdfs:label "Landkarte-Annotationsschlüssel"@de , "Landkarte annotation key"@en ;
    rdfs:domain dstack:Kriterium ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "The landscape2 cf_* annotation stem (e.g. 'cf_sovereignty') for the roundtrip; a projection fact."@en .


# =============================================================================
# The planning layer — checking and extending a landscape against the Stack
# -----------------------------------------------------------------------------
# A municipal IT landscape (authored/musterstadt-it-landschaft.fictional.ttl) is modelled in
# ArchiMate (purl.org/archimate, reused by IRI) and joined to the technical layer by
# dct:conformsTo: a component conforms to the Landkarte StackElement it follows (or to a
# dstack:ReferenzierterStandard the Landkarte lacks). On top of that, a planned project
# (musterstadt-chatbot.scenario.ttl) is an archimate:WorkPackage that dstack:benoetigt a set of
# archimate:Capability, each naming a dstack:kandidat Stack element. Reuse-vs-new and the
# before/after coverage are not stored; they follow from the landscape via SPARQL.
# =============================================================================

dstack:benoetigt a rdf:Property ;
    rdfs:label "benötigt"@de , "requires"@en ;
    rdfs:domain archimate:WorkPackage ; rdfs:range archimate:Capability ;
    rdfs:comment "A planned project (archimate:WorkPackage) requires this capability (archimate:Capability), to check or extend a landscape against the Stack."@en .

dstack:kandidat a rdf:Property ;
    rdfs:label "Kandidat"@de , "candidate"@en ;
    rdfs:domain archimate:Capability ;
    rdfs:comment "An option evaluated for this capability: either a Landkarte StackElement (then Stack-aligned, and reuse-vs-new follows from dct:conformsTo in the landscape) or a non-Stack alternative (a labelled node with no Landkarte bond). A proposal, not an existing realisation."@en .


# =============================================================================
# Properties — the openCode conformance layer (opencode-konformitaet.scenario.ttl)
# -----------------------------------------------------------------------------
# An automated scan of openCode repositories. A repository (schema:SoftwareSourceCode,
# schema:codeRepository) dct:hasPart the dstack:Abhaengigkeit entries a scanner reads from its
# manifests. Each maps (dstack:abgebildetAuf) onto one of three targets — a Landkarte StackElement
# (konform), a dstack:ReferenzierterStandard without a tile (blinder Fleck), or a
# dstack:ProprietaeresProdukt (proprietär) — or onto nothing at all (nicht erkannt: the scanner has
# no mapping, an honestly disclosed limit rather than a silent failure). The package coordinate
# (dstack:paket) and manifest file (dstack:ausManifest) carry the evidence; declared versions are
# omitted in the scenario. abgebildetAuf is a heuristic mapping from a package name, not a verified conformance
# claim, so it is deliberately a separate predicate from dct:conformsTo.
# =============================================================================

dstack:Abhaengigkeit a rdfs:Class ;
    rdfs:label "Abhängigkeit"@de , "dependency"@en ;
    rdfs:comment "A dependency an automated scanner read from a repository's manifest (package.json, build.gradle, requirements.txt, go.mod, Dockerfile, k8s manifest). It carries its package coordinate (dstack:paket) and the manifest file it came from (dstack:ausManifest), and is mapped via dstack:abgebildetAuf to a StackElement, a ReferenzierterStandard or a ProprietaeresProdukt — or to nothing, which means nicht erkannt."@en .

dstack:ProprietaeresProdukt a rdfs:Class ;
    rdfs:label "proprietäres Produkt"@de , "proprietary product"@en ;
    rdfs:comment "A recognised closed product a dependency maps to (Oracle Database, OpenAI API, ...): no open D-Stack equivalent, an open Stack alternative usually named in dct:description. Distinct from a dependency with no mapping at all (nicht erkannt), so a positive proprietary finding is never conflated with the scanner's blind tail."@en .

dstack:abgebildetAuf a rdf:Property ;
    rdfs:label "abgebildet auf"@de , "mapped to"@en ;
    rdfs:domain dstack:Abhaengigkeit ;
    rdfs:comment "The target(s) a scanner heuristically maps this dependency to: a Landkarte StackElement (konform), a dstack:ReferenzierterStandard the Landkarte lacks (blinder Fleck), or a dstack:ProprietaeresProdukt (proprietär). The relation is many-to-many: a dependency can embody several standards (a web framework -> REST and OpenAPI). It is a hand-curated, LLM-assisted mapping that must be actively maintained, not a verified conformance claim, so deliberately distinct from dct:conformsTo. Its absence means nicht erkannt: the scanner has no mapping, disclosed rather than counted as a failure."@en .

dstack:realesProjekt a rdf:Property ;
    rdfs:label "reales Projekt"@de , "real project"@en ;
    rdfs:domain schema:SoftwareSourceCode ; rdfs:range xsd:boolean ;
    rdfs:comment "true marks a scanned repository as a real openCode project: its dependencies are the actual declared ones from its manifests, snapshotted via dct:source/dct:date. Its absence marks an illustrative example. In both cases the package->standard mapping (dstack:abgebildetAuf) is a hand-curated heuristic, not part of the real manifest."@en .

dstack:vollstaendigGescannt a rdf:Property ;
    rdfs:label "vollständig gescannt"@de , "fully scanned"@en ;
    rdfs:domain schema:SoftwareSourceCode ; rdfs:range xsd:boolean ;
    rdfs:comment "true means every manifest of the repository was scanned, so absence-of-finding claims (no proprietary, no blind spot) are safe and the standards count is exact. false marks a Stichprobe (only a sample of the manifests, e.g. a large monorepo): findings still hold, but the standards count is only a lower bound and no overall conformance verdict is issued. An honesty marker, so a count over a sample is never read as a conformance score."@en .

dstack:manifesteGesamt a rdf:Property ;
    rdfs:label "Manifeste gesamt"@de , "total manifests"@en ;
    rdfs:domain schema:SoftwareSourceCode ; rdfs:range xsd:integer ;
    rdfs:comment "For a sampled repository (dstack:vollstaendigGescannt false), the total number of manifest files it declares, so the scan scope can be shown honestly as 'N of over M' rather than just N. Lets a Stichprobe state its own denominator."@en .

dstack:offeneAlternative a rdf:Property ;
    rdfs:label "offene Alternative"@de , "open alternative"@en ;
    rdfs:domain dstack:ProprietaeresProdukt ; rdfs:range rdfs:Literal ;
    rdfs:comment "A short label of the open D-Stack alternative to a proprietary product (e.g. 'PostgreSQL' for Oracle), so the conformance view can name the alternative concisely without the full prose description (which stays in dct:description). Not every proprietary product has one (e.g. a captcha service has no open D-Stack equivalent)."@en .

dstack:OpenCodeBadge a rdfs:Class ;
    rdfs:label "openCode-Badge"@de , "openCode badge"@en ;
    rdfs:comment "A quality dimension in openCode's live, BSI-aligned badge system (active maintenance, reuse, open-source licence, security, supply-chain transparency), crosswalked via skos:closeMatch / skos:relatedMatch to the D-Stack's Konformität-Kriterien — so where the two systems overlap and where the D-Stack adds something is queryable. A sixth, dstack:vorgeschlagen, is this prototype's proposed Deutschland-Stack-conformance badge, not an official openCode badge."@en .

dstack:vorgeschlagen a rdf:Property ;
    rdfs:label "vorgeschlagen"@de , "proposed"@en ;
    rdfs:range xsd:boolean ;
    rdfs:comment "true marks a node as a proposal of this prototype rather than an existing/official artefact (e.g. the proposed sixth openCode badge). An honesty marker, kept queryable."@en .

dstack:paket a rdf:Property ;
    rdfs:label "Paket"@de , "package"@en ;
    rdfs:domain dstack:Abhaengigkeit ; rdfs:range xsd:string ;
    rdfs:comment "The package coordinate as it appears in the manifest (e.g. \"openid-client\", \"org.postgresql:postgresql\", \"github.com/coreos/go-oidc/v3\")."@en .

dstack:ausManifest a rdf:Property ;
    rdfs:label "aus Manifest"@de , "from manifest"@en ;
    rdfs:domain dstack:Abhaengigkeit ; rdfs:range xsd:string ;
    rdfs:comment "The manifest file a dependency was declared in (package.json, build.gradle, requirements.txt, go.mod, Dockerfile, k8s/deployment.yaml): the provenance of the scan finding."@en .


# =============================================================================
# The communication layer — comms snippets rendered straight from the graph
# -----------------------------------------------------------------------------
# Explanations about the Stack are hung onto the graph (authored/comms.authored.ttl) instead of
# kept in separate documents that go stale. dstack:Textbaustein is the one local class; everything a
# snippet carries reuses existing terms (listed in the communication block under "Reused
# vocabularies" below): schema:headline / schema:text are the authored framing (with {{placeholders}}),
# sh:select is the snippet's OWN SPARQL query the webapp runs live to fill them, rdfs:label is the
# tag, sh:order the order, schema:about the node it is anchored on. The fachlich register reuses
# dct:description with a private-use language tag (@de-x-fachlich) — a second register of the same
# description alongside the upstream @de text, so no new term at all.
# =============================================================================

dstack:Textbaustein a rdfs:Class ;
    rdfs:subClassOf schema:CreativeWork ;
    rdfs:label "Textbaustein"@de , "Comms snippet"@en ;
    rdfs:comment "A self-describing communication snippet: it carries its OWN SPARQL SELECT (sh:select), which the webapp runs live to fill the {{placeholders}} in its authored framing (schema:headline + schema:text), so the rendered comms piece is a current, traceable projection of the graph. The tag label is its rdfs:label, the order sh:order, and schema:about the graph node it is anchored on. The only local term in this layer; everything else is reused."@en .


# =============================================================================
# Properties — the 115 First-Level-Support layer (115-od-support.scenario.ttl)
# -----------------------------------------------------------------------------
# These three hang First-Level-Support facts onto a real Onlinedienst (m8g:Channel) so the 115 can
# beauskunften it: its current operating status, its help resources and its escalation contact. All
# three values are a hand-authored stand-in (for the internal 115-Wissensdatenbank); the
# Channel they attach to is real. The citizen-facing Stichworte reuse skos:altLabel/hiddenLabel on the
# Leistung (see the reused block below), so no own term is needed for the semantic lookup.
# =============================================================================

dstack:betriebsstatus a rdf:Property ;
    rdfs:label "Betriebsstatus"@de , "operating status"@en ;
    rdfs:domain m8g:Channel ; rdfs:range skos:Concept ;
    rdfs:comment "The current operating status of an Onlinedienst (verfügbar / gestört / nur lokal nicht erfasst), as a Frühwarnsystem (DIN SPEC 66336) would report it, so the 115 knows before the call whether it can point a citizen there."@en .

dstack:hilfeRessource a rdf:Property ;
    rdfs:label "Hilfe-Ressource"@de , "help resource"@en ;
    rdfs:domain m8g:Channel ; rdfs:range schema:CreativeWork ;
    rdfs:comment "A help resource for an Onlinedienst (Handbuch, FAQ, Anleitung), typed via dct:type and linked via schema:url. In reality these reach the 115 as Links in the XZuFi-Leistungsbericht; modelled here as a stand-in."@en .

dstack:zweitLevelKontakt a rdf:Property ;
    rdfs:label "Second-Level-Kontakt"@de , "second-level contact"@en ;
    rdfs:domain m8g:Channel ; rdfs:range schema:ContactPoint ;
    rdfs:comment "The Second-Level-Support an agent escalates to when first-level cannot resolve an Onlinedienst question (fachlich/technisch, telefonisch oder per Ticket)."@en .


# =============================================================================
# Provenance — the Schicht meta describing each named graph (loaded by graph.js)
# -----------------------------------------------------------------------------
# graph.js loads every layer twice: into the default graph (ordinary queries stay unchanged)
# AND into a per-layer named graph, so GRAPH ?g { ... } reveals which layer a triple is from.
# These terms describe each of those named graphs — its Herkunft (the file-naming convention,
# made queryable) plus a label and the source file — so the graph can give an account of itself
# (Selbstauskunft: Annahmen & Lücken). The meta lives in the default graph and uses only dstack: predicates,
# so it never surfaces in ordinary label/type queries.
# =============================================================================

dstack:Schicht a rdfs:Class ;
    rdfs:label "Schicht"@de , "Layer"@en ;
    rdfs:comment "A named graph: one source layer of the composed graph, identified by an IRI under .../id/graph/. It bears its Herkunft, a label and its source file; the webapp joins layer content to this description via GRAPH ?g {} . ?g dstack:herkunft ?h ."@en .

dstack:herkunft a rdf:Property ;
    rdfs:label "Herkunft"@de , "provenance class"@en ;
    rdfs:domain dstack:Schicht ;
    rdfs:comment "The provenance class of a Schicht, mirroring the file-naming convention: 'offiziell geliftet' (machine-lifted from official sources), 'transkribiert' (hand-transcribed from dated decisions), 'verfasst' (hand-authored prose), 'angenommen' (.assumed), 'fiktiv' (.fictional), 'Szenario' (.scenario). The graph's honesty, made queryable."@en .

dstack:schichtLabel a rdf:Property ;
    rdfs:label "Schicht-Label"@de , "layer label"@en ;
    rdfs:domain dstack:Schicht ;
    rdfs:comment "A human-readable label for a Schicht. Deliberately a dstack: predicate (not rdfs:label), so the meta does not show up in ordinary label queries over the default graph."@en .

dstack:schichtDatei a rdf:Property ;
    rdfs:label "Schicht-Datei"@de , "layer file"@en ;
    rdfs:domain dstack:Schicht ;
    rdfs:comment "The source file a Schicht was loaded from (e.g. pvog-dstack-bridge.assumed.ttl); its extension encodes the Herkunft."@en .


# =============================================================================
# Reused vocabularies (documented here, defined elsewhere)
# -----------------------------------------------------------------------------
# The vocabularies are declared machine-readably via voaf:reliesOn on the node at
# the top of this file; this block keeps the per-term "for what". The graph uses
# these external terms with their standard meaning; it does not redefine them:
#
# Technical layer (the Landkarte):
#   skos:ConceptScheme              ds:landkarte — the Schicht/Gruppe taxonomy root
#   skos:Concept                    each Schicht and each Gruppe
#   skos:prefLabel                  labels on items, criteria, schichten, gruppen, scheme
#   skos:hasTopConcept / topConceptOf   scheme ↔ Schicht
#   skos:broader                    Gruppe → its Schicht
#   skos:inScheme                   Schicht/Gruppe → ds:landkarte
#   dct:subject                     StackElement → its Gruppe concept
#   dct:description                 StackElement description (@de)
#   dct:source / dct:date           provenance stamp on ds:landkarte (origin URL + retrieval date)
#   schema:url                      StackElement homepage
#   schema:version                  StackElement version
#
# Administrative layer (the PVOG services) — the EU public-service vocabularies,
# reused directly so a CPSV-AP query runs on this data unchanged:
#   cpsv:PublicService              a Verwaltungsleistung (the service node)
#   cpsv:follows → cpsv:Rule        the legal basis (Rechtsgrundlage, free text on the Rule)
#   m8g:PublicOrganisation          a zuständige Stelle
#   m8g:hasCompetentAuthority       PublicService → its responsible Stelle(n)
#   m8g:LifeEvent                   a Lebenslage; m8g:isGroupedBy links the service to it
#   m8g:Channel                     an Onlinedienst; m8g:hasChannel links the service to it
#   m8g:hasCost → m8g:Cost          the cost/fee info (Kosten, free text on the Cost)
#   dct:title                       names of the service / channel / life event
#   dct:description / dct:language  service description and languages
#   dct:identifier                  the PVOG lbid (service), and PVOG ids on Stelle / Channel
#   dct:source                      per-Leistung PVOG v6 /detail URL (provenance)
#   dct:spatial                     the ARS, as the official dcat-ap.de regional-key concept IRI
#   skos:prefLabel                  PublicOrganisation name
#   skos:notation                   LifeEvent code
#   schema:url                      Channel (Onlinedienst) URL
#   schema:validFrom / validThrough service validity period
#   rdfs:seeAlso / rdfs:comment     links, and the unofficial-reconstruction disclaimer on ds:landkarte
#
# Communication layer (the comms snippets, authored/comms.authored.ttl) — only dstack:Textbaustein
# is local; each snippet reuses:
#   rdfs:label                      the snippet's tag label (e.g. "Souveränität")
#   sh:order                        the tag's display order
#   schema:about                    the graph node the snippet is anchored on
#   schema:headline                 the headline template ({{placeholders}})
#   schema:text                     the per-result-row template ({{placeholders}})
#   schema:description              a short caption shown with the rendered snippet
#   sh:select                       the snippet's OWN SPARQL SELECT, carried as a literal, run live
#   dct:description @de-x-fachlich   a fachliche (subject-matter) register of a StackElement's description
#   schema:Report                   a per-Leistung report definition, likewise carrying its sh:select
#
# 115 First-Level-Support layer (115-od-support.scenario.ttl) — three local properties above; reuses:
#   skos:altLabel                   colloquial synonyms of a Leistung (e.g. "Mietzuschuss" → Wohngeld)
#   skos:hiddenLabel                misnomers a citizen says (e.g. "polizeiliches Führungszeugnis")
#   skos:ConceptScheme / Concept    the Betriebsstatus value set; skos:prefLabel its labels
#   schema:CreativeWork             a Hilfe-Ressource (Handbuch/FAQ/Anleitung); dct:type its kind, schema:url its link
#   schema:ContactPoint             a Second-Level-Support contact; schema:contactType its kind
#   cpsv:hasInput → m8g:Evidence    erforderliche Unterlagen je Leistung (dct:title) — reused CPSV-AP terms
#   m8g:hasCost → m8g:Cost          Gebühren — real aus PVOG (free-text dct:description) für drei der vier Dienste;
#                                   beim Führungszeugnis eine zweite, eigene m8g:Cost (Blank Node), da PVOG leer war
#   m8g:value / m8g:currency        der ergänzte Betrag als Ganzzahl + Währung auf diesem Blank Node
#   dct:source / rdfs:comment       dessen Herkunft direkt am Knoten (JVKostG-Quelle + Von-Hand-Hinweis), statt Reifikation
# =============================================================================
