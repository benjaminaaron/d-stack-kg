  dstack:landkarteItemId "-infrastruktur---verteilung--border-gateway-protocol-bgp";
  dstack:landkarteLogoFile "8113b974fdfd48ae1568e95aa2ea200dafbbeaea1e519eafe8294d3f85f14433.png";
  dstack:landkartePosition 1;
  dstack:reifegrad "graduated";
  dstack:verantwortlicheStelle "IETF".

