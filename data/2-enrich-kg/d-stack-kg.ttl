  dstack:landkarteItemId "-infrastruktur---verteilung--media-access-control-mac";
  dstack:landkarteLogoFile "72783e60cc7c2a13d10f9641b0fd71c418a0da3ed4cc7a2b8b2776cd0e3bdc0f.png";
  dstack:landkartePosition 6;
  dstack:reifegrad "graduated";
  dstack:verantwortlicheStelle "IEEE".

