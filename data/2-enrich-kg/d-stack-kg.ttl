    ds:konformitaet-langgraph-zukunftsfaehigkeit;
  dstack:landkarteItemId "-plattform---ki--langgraph";
  dstack:landkarteLogoFile "187304c9cc751996412a38051e565018e6dde23d78b0af5c4be6b39209713e24.png";
  dstack:landkartePosition 8;
  dstack:reifegrad "graduated";
  dstack:verantwortlicheStelle "LangChain Inc.".

